FROM alpine/git:2.45.2 AS source
ARG WEB_POKER_REF=master
WORKDIR /src
RUN git clone --depth 1 --branch "${WEB_POKER_REF}" https://github.com/alexander171294/web-poker.git web-poker
WORKDIR /src/web-poker
COPY containers/web-poker/overrides/backend/room/src/main/java/ar/com/tandilweb/room/protocols/EpprRoomAuth.java /src/web-poker/backend/room/src/main/java/ar/com/tandilweb/room/protocols/EpprRoomAuth.java

FROM maven:3.9.9-eclipse-temurin-11 AS build
WORKDIR /work
COPY --from=source /src/web-poker/ ./
RUN set -eux; \
    mvn -f backend/exchange/pom.xml clean install; \
    mvn -f backend/persistence/pom.xml clean install; \
    mvn -f backend/room-int/pom.xml clean install; \
    mvn -f backend/room-poker/room-poker/pom.xml clean install; \
    mvn -f backend/room/pom.xml clean package -DskipTests

FROM eclipse-temurin:11-jre-jammy
RUN addgroup --system web-poker-room && adduser --system --ingroup web-poker-room --home /home/web-poker-room web-poker-room
USER web-poker-room:web-poker-room
WORKDIR /home/web-poker-room
RUN mkdir -p /home/web-poker-room/dataSave /home/web-poker-room/logs
COPY --from=build /work/backend/room/target/*.jar /opt/web-poker/room.jar
ENV SERVER_PORT=8081 \
    CONFIG_FILE=/home/web-poker-room/dataSave \
    LOGGING_LEVEL=WARN \
    ROOM_NAME="Levangie Poker" \
    ACCESS_PASSWORD= \
    SECURITY_TOKEN= \
    MAX_PLAYERS=10 \
    DESCRIPTION="Private Texas Hold'em room" \
    MIN_CHIPS_FOR_ACCESS=250 \
    SERVER_PUBLIC_HOST=poker.levangie.dev \
    SERVER_PUBLIC_PORT=443 \
    RECOVERY_EMAIL=poker@levangie.org \
    ORCHESTRATOR_LISTEN_PORT=8045 \
    ORCHESTRATOR_IP=web-poker-orchestrator \
    TZ=America/New_York
ENTRYPOINT ["sh", "-c", "exec java -jar -Duser.timezone=\"$TZ\" -Dserver.port=\"$SERVER_PORT\" -Dact.room.cfgFileSave=\"$CONFIG_FILE\" -Dlogging.level.ar.com.tandilweb=\"$LOGGING_LEVEL\" -Dact.room.RoomAuth.name=\"$ROOM_NAME\" -Dact.room.RoomAuth.accessPassword=\"$ACCESS_PASSWORD\" -Dact.room.RoomAuth.securityToken=\"$SECURITY_TOKEN\" -Dact.room.RoomAuth.maxPlayers=\"$MAX_PLAYERS\" -Dact.room.RoomAuth.description=\"$DESCRIPTION\" -Dact.room.RoomAuth.minCoinsForAccess=\"$MIN_CHIPS_FOR_ACCESS\" -Dact.room.RoomAuth.recoveryEmail=\"$RECOVERY_EMAIL\" -Dact.room.RoomAuth.serverPublicHost=\"$SERVER_PUBLIC_HOST\" -Dact.room.RoomAuth.serverPublicPort=\"$SERVER_PUBLIC_PORT\" -Dact.room.orchestrator.remoteListenerPort=\"$ORCHESTRATOR_LISTEN_PORT\" -Dact.room.orchestrator.remoteAddr=\"$ORCHESTRATOR_IP\" /opt/web-poker/room.jar"]
