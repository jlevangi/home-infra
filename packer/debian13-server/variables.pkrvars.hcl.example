# Packer variables for Debian 13 template
# Copy this file to variables.pkrvars.hcl and fill in your values

proxmox_url      = "https://172.20.20.6:8006/api2/json"
proxmox_username = "terraform@pam!tf-token"
proxmox_token    = "your-api-token-here"
proxmox_node     = "atlas"

# ISO must be uploaded to Proxmox first
iso_file = "local:iso/debian-13.7.0-amd64-netinst.iso"

# Template settings
vm_id         = 9010
template_name = "debian13-server-template"
storage_pool  = "tank"

# Provisioning credentials (temporary, locked after template creation)
ssh_username = "packer"
ssh_password = "packer"
