# Atlas API token
token_id     = "terraform@pam!tf-token"
token_secret = "replace-me"

# Cloud-init user (matches existing prod tfvars)
ci_user     = "pierce"
ci_password = "replace-me"

ssh_key = "ssh-ed25519 AAAA... replace-me"

# Network configuration
ip_address    = "172.20.20.107"
subnet_mask   = "22"
gateway       = "172.20.20.1"
nameserver    = "172.20.20.4"
search_domain = "local"

# Storage layout on Atlas:
#   - OS + cloud-init on flash
#   - Longhorn data on flash; stage/test workers still keep data disks on tank
vm_storage        = "local-lvm"
os_disk_size      = "80G"
data_disk_storage = "flash"
data_disk_size    = "200G"
