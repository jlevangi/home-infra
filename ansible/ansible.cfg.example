; Ansible connection defaults for this repo.
;
; Copy this file to `ansible/ansible.cfg` and edit it to match your local
; environment. The real file is gitignored so personal paths never get
; committed. Scripts under scripts/ set ANSIBLE_CONFIG to this file
; automatically, so you do not need to export anything in your shell.

[defaults]
; User that cloud-init provisioned on each VM. Must match the `ci_user`
; value in terraform/<cluster>/terraform.tfvars (default: ansible).
remote_user = ansible

; Path to the private key that corresponds to the public key baked into
; cloud-init. Change this to whichever key you actually use to reach the
; cluster hosts.
private_key_file = ~/.ssh/id_ed25519

host_key_checking = False
interpreter_python = /usr/bin/python3
retry_files_enabled = False
stdout_callback = default

; SSH connect timeout. Bumped from the 10s default so slow-booting or
; resource-pressured nodes (Longhorn install, helm --wait) do not trip
; spurious "Timeout waiting for privilege escalation prompt" errors.
timeout = 30

[privilege_escalation]
; Time Ansible will wait for sudo to return before giving up. Default is
; 10s which is too tight when the target node is under memory pressure
; (e.g. mid-Longhorn install on a 4G test VM).
become_timeout = 60

[ssh_connection]
; ControlPersist bumped to 300s to outlive long `helm --wait` and
; `kubectl wait` tasks so we do not rebuild the multiplexed socket
; repeatedly. ServerAliveInterval/CountMax keep the TCP session alive
; during long in-task waits.
ssh_args = -o ControlMaster=auto -o ControlPersist=300s -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=3
pipelining = True
