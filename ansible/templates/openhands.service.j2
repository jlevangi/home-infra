[Unit]
Description=OpenHands Agent Canvas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openhands_user }}
Group={{ openhands_user }}
WorkingDirectory={{ openhands_home }}/workspace
EnvironmentFile=/etc/openhands.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/agent-canvas --port {{ openhands_port }}
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{ openhands_home }}

[Install]
WantedBy=multi-user.target
