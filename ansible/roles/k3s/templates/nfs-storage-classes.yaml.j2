---
# NFS Storage Classes for K3s Cluster
# These provide persistent storage backed by Synology NAS
# Generated by Ansible from template

# Database Storage Class - High Performance, Retain Policy
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ storage_classes.nfs_database | default('nfs-database') }}
  annotations:
    storageclass.kubernetes.io/is-default-class: "false"
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ nfs_server }}  # Synology NAS IP/hostname
  share: {{ nfs_path }}/database
  mountPermissions: "0755"
{% if nfs_user is defined and nfs_password is defined %}
  # NFS authentication parameters for service account
  mountOptions: "vers=4,minorversion=0,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2"
{% endif %}
reclaimPolicy: Retain  # Retain data even if PVC is deleted
volumeBindingMode: Immediate
allowVolumeExpansion: true
---
# Application Storage Class - General Purpose (Default)
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ storage_classes.nfs_apps | default('nfs-apps') }}
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"  # Make this the default
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ nfs_server }}
  share: {{ nfs_path }}/apps
  mountPermissions: "0755"
{% if nfs_user is defined and nfs_password is defined %}
  # NFS authentication parameters for service account
  mountOptions: "vers=4,minorversion=0,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2"
{% endif %}
reclaimPolicy: Retain
volumeBindingMode: Immediate
allowVolumeExpansion: true
---
# Shared Storage Class - ReadWriteMany support
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ storage_classes.nfs_shared | default('nfs-shared') }}
  annotations:
    storageclass.kubernetes.io/is-default-class: "false"
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ nfs_server }}
  share: {{ nfs_path }}/shared
  mountPermissions: "0777"  # More permissive for shared access
{% if nfs_user is defined and nfs_password is defined %}
  # NFS authentication parameters for service account
  mountOptions: "vers=4,minorversion=0,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2"
{% endif %}
reclaimPolicy: Retain
volumeBindingMode: Immediate
allowVolumeExpansion: true
volumeBindingMode: Immediate
allowVolumeExpansion: true
---
# Backup Storage Class - Long-term retention
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ storage_classes.nfs_backup | default('nfs-backup') }}
  annotations:
    storageclass.kubernetes.io/is-default-class: "false"
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ nfs_server }}
  share: {{ nfs_path }}/backups
  mountPermissions: "0755"
{% if nfs_user is defined and nfs_password is defined %}
  # NFS authentication parameters for service account
  mountOptions: "vers=4,minorversion=0,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2"
{% endif %}
reclaimPolicy: Retain
volumeBindingMode: Immediate
allowVolumeExpansion: true
