---
# Vaultwarden ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: vaultwarden-config
  namespace: vaultwarden
data:
  DOMAIN: "{{ app_definitions.vaultwarden.app_url }}"
  ADMIN_TOKEN: "{{ app_definitions.vaultwarden.secrets.admin_token }}"
  # Reverse proxy configuration - Caddy terminates SSL and forwards HTTP to Traefik
  ROCKET_TLS: "{disabled=true}"
  ROCKET_PORT: "80"
  DB_TYPE: "default"
  STORAGE_CLAIM: "vaultwarden-data-pvc"
  # PUID: "{{ dynamic_nfs_uid | default('1024') }}"  # NFS-related, commented out for Longhorn
  # PGID: "{{ dynamic_nfs_gid | default('100') }}"   # NFS-related, commented out for Longhorn
  TZ: "{{ application_timezone | default('America/New_York') }}"
  SMTP_HOST: "{{ vault_smtp_host }}"
  SMTP_PORT: "587"
  SMTP_SECURITY: "starttls"
  SMTP_USERNAME: "{{ vault_smtp_username }}"
  SMTP_PASSWORD: "{{ vault_smtp_password }}"
  SMTP_FROM: "vaultwarden@levangie.org"
  WEB_VAULT_ENABLED: "true"
  SIGNUPS_ALLOWED: "false"
  INVITATIONS_ALLOWED: "true"