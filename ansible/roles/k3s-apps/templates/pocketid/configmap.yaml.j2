---
# Pocket ID ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: pocketid-config
  namespace: pocketid
data:
  APP_URL: "{{ applications.pocketid.app_url }}"
  TRUST_PROXY: "{{ applications.pocketid.config.trust_proxy | default('true') }}"
  ALLOW_USER_SIGNUPS: "{{ applications.pocketid.config.allow_user_signups | default('disabled') }}"
  PUID: "{{ applications.pocketid.config.puid | default('1000') }}"
  PGID: "{{ applications.pocketid.config.pgid | default('1000') }}"
  TZ: "{{ applications.pocketid.config.timezone | default('America/New_York') }}"
