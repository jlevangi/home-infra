---
# BookStack with Host Path Storage (using /mnt/k3s-storage)
# This version uses host path mounts to the NFS share for direct file access
# Updated to work with k3s-app-user (UID 1024) and proper directory ownership

# ConfigMap for BookStack configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: bookstack-config
  namespace: bookstack
data:
  DB_HOST: "bookstack-mariadb"
  DB_PORT: "3306"
  DB_USER: "bookstack"
  DB_DATABASE: "bookstack"
  APP_URL: "{{ bookstack_app_url | default('https://bsk3.levangie.org') }}"
  SESSION_LIFETIME: "7200"
  PUID: "1024"  # Use NFS admin UID directly
  PGID: "100"   # Use users group directly
  TZ: "{{ bookstack_timezone | default('America/New_York') }}"
---
# MariaDB Deployment with Host Path Storage
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bookstack-mariadb
  namespace: bookstack
spec:
  replicas: 1
  selector:
    matchLabels:
      app: bookstack-mariadb
  template:
    metadata:
      labels:
        app: bookstack-mariadb
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      containers:
      - name: mariadb
        image: linuxserver/mariadb:latest
        env:
        - name: PUID
          value: "1024"  # Use the NFS admin UID directly
        - name: PGID
          value: "100"   # Use the users group directly
        - name: TZ
          value: "{{ bookstack_timezone | default('America/New_York') }}"
        - name: MYSQL_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: MYSQL_ROOT_PASSWORD
        - name: MYSQL_DATABASE
          value: "bookstack"
        - name: MYSQL_USER
          value: "bookstack"
        - name: MYSQL_PASSWORD
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: MYSQL_PASSWORD
        ports:
        - containerPort: 3306
        volumeMounts:
        - name: db-storage
          mountPath: /config
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
      volumes:
      - name: db-storage
        hostPath:
          path: /mnt/k3s-storage/database/bookstack
          type: DirectoryOrCreate
---
# MariaDB Service
apiVersion: v1
kind: Service
metadata:
  name: bookstack-mariadb
  namespace: bookstack
spec:
  selector:
    app: bookstack-mariadb
  ports:
  - port: 3306
    targetPort: 3306
  type: LoadBalancer
---
# BookStack Deployment with Host Path Storage
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bookstack
  namespace: bookstack
spec:
  replicas: 1
  selector:
    matchLabels:
      app: bookstack
  template:
    metadata:
      labels:
        app: bookstack
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      initContainers:
      - name: wait-for-db
        image: busybox:1.35
        command: ['sh', '-c']
        args:
        - |
          echo "Waiting for MariaDB to be ready..."
          until nc -z bookstack-mariadb 3306; do
            echo "MariaDB not ready, waiting..."
            sleep 10
          done
          echo "MariaDB is ready!"
          sleep 10
      containers:
      - name: bookstack
        image: linuxserver/bookstack:latest
        env:
        - name: PUID
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: PUID
        - name: PGID
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: PGID
        - name: DB_HOST
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_HOST
        - name: DB_PORT
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_PORT
        - name: DB_USERNAME
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_USER
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: DB_PASS
        - name: DB_DATABASE
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_DATABASE
        - name: APP_URL
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: APP_URL
        - name: SESSION_LIFETIME
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: SESSION_LIFETIME
        - name: APP_KEY
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: APP_KEY
        - name: TZ
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: TZ
        ports:
        - containerPort: 80
        volumeMounts:
        - name: config-storage
          mountPath: /config
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 120
          periodSeconds: 30
          timeoutSeconds: 10
          failureThreshold: 5
        livenessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 180
          periodSeconds: 60
          timeoutSeconds: 10
          failureThreshold: 3
        # Remove explicit securityContext - let LinuxServer image handle user switching via PUID/PGID
      volumes:
      - name: config-storage
        hostPath:
          path: /mnt/k3s-storage/apps/bookstack
          type: DirectoryOrCreate
---
# BookStack Service
apiVersion: v1
kind: Service
metadata:
  name: bookstack
  namespace: bookstack
spec:
  selector:
    app: bookstack
  ports:
  - port: 8080
    targetPort: 80
  type: LoadBalancer
---
# Simple HTTP-only Ingress for BookStack (TLS handled by Caddy)
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: bookstack-ingress
  namespace: bookstack
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
spec:
  ingressClassName: traefik
  rules:
  - host: {{ bookstack_app_url | default('bsk3.levangie.org') | regex_replace('https?://','') }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: bookstack
            port:
              number: 8080
