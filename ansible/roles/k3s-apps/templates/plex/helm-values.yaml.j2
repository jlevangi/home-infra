# Plex Media Server Helm Values
# Generated by Ansible for {{ cluster_environment | default('unknown') }} environment

# Image configuration
image:
  tag: "1.42.1.10054-f333bdaa8"  # Stable version, update as needed

# Service configuration
service:
  type: ClusterIP
  port: {{ plex_config.service_port | default(32400) }}

# Ingress configuration
ingress:
  enabled: false  # We handle ingress separately with Traefik

# Storage configuration
persistence:
  config:
    enabled: true
    size: {{ plex_config.storage.config_initial_size | default('2Gi') }}
    {% if plex_config.storage.storage_class is defined %}
    storageClass: {{ plex_config.storage.storage_class }}
    {% endif %}

# Resource configuration
resources:
  requests:
    cpu: {{ plex_config.config.resources.requests.cpu | default('100m') }}
    memory: {{ plex_config.config.resources.requests.memory | default('512Mi') }}
  limits:
    cpu: {{ plex_config.config.resources.limits.cpu | default('2000m') }}
    memory: {{ plex_config.config.resources.limits.memory | default('4Gi') }}

# Environment variables
env:
  TZ: {{ plex_config.config.timezone | default('America/New_York') }}
  {% if plex_config.config.claim_token is defined and plex_config.config.claim_token %}
  PLEX_CLAIM: {{ plex_config.config.claim_token }}
  {% endif %}

# GPU support (NVIDIA)
{% if plex_config.config.gpu_enabled | default(false) %}
runtimeClassName: nvidia
tolerations:
  - key: nvidia.com/gpu
    operator: Exists
    effect: NoSchedule
nodeSelector:
  accelerator: nvidia
{% endif %}

# Security context
securityContext:
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000

# Additional volumes for media (can be customized)
extraVolumes:
- name: media
  nfs:
    server: {{ vault_nfs_server }}
    path: /volume1/media

extraVolumeMounts:
- name: media
  mountPath: /media
  readOnly: true

# Service account
serviceAccount:
  create: true
  name: ""

# Pod annotations
podAnnotations: {}

# Pod security context
podSecurityContext:
  fsGroup: 1000

# Node selector
nodeSelector: {}

# Tolerations
tolerations: []

# Affinity
affinity: {}

# Liveness and readiness probes
probes:
  liveness:
    enabled: true
    failureThreshold: 3
    periodSeconds: 10
    timeoutSeconds: 30
  readiness:
    enabled: true
    failureThreshold: 3
    periodSeconds: 10
    timeoutSeconds: 30

# Additional containers (e.g., for rclone)
extraContainers: []

# Init containers
initContainers: []