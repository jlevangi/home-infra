# {{ app_name | title }} LimitRange - PVC Size Constraints
apiVersion: v1
kind: LimitRange
metadata:
  name: {{ app_name }}-storage-limits
  namespace: {{ app_name }}
spec:
  limits:
  # Constraints for PersistentVolumeClaims
  - type: PersistentVolumeClaim
    max:
      # Maximum size for any single PVC
      storage: "{{ max_pvc_size | default('20Gi') }}"
    min:
      # Minimum size for any PVC (prevents tiny allocations)
      storage: "{{ min_pvc_size | default('10Mi') }}"
    default:
      # Default size if not specified
      storage: "{{ default_pvc_size | default('1Gi') }}"
    defaultRequest:
      # Default request if not specified
      storage: "{{ default_pvc_size | default('1Gi') }}"