---
# Homepage Dashboard Deployment
# Based on Kompose conversion but enhanced for production K3s with NFS storage
# Original Docker Compose converted with proper security contexts and storage

# ConfigMap for Homepage configuration
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-config
  namespace: homepage
data:
  HOMEPAGE_ALLOWED_HOSTS: "{{ homepage_app_url | regex_replace('^https?://') }}"
  TZ: "{{ homepage_timezone | default('America/New_York') }}"
  PUID: "1024"
  PGID: "100"
---
---
# Homepage Deployment (enhanced from Kompose output)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: homepage
  labels:
    app: homepage
    app.kubernetes.io/name: homepage
    app.kubernetes.io/component: dashboard
spec:
  replicas: 1
  strategy:
    type: Recreate  # Preserve from Kompose - important for persistent storage
  selector:
    matchLabels:
      app: homepage
  template:
    metadata:
      labels:
        app: homepage
        app.kubernetes.io/name: homepage
        app.kubernetes.io/component: dashboard
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      containers:
      - name: homepage
        image: ghcr.io/gethomepage/homepage:latest
        imagePullPolicy: Always
        envFrom:
        - configMapRef:
            name: homepage-config
        ports:
        - containerPort: 3000
          protocol: TCP
          name: http
        volumeMounts:
        - name: homepage-config
          mountPath: /app/config
        # Resource limits (production ready)
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        # Health checks (missing from Kompose output)
        livenessProbe:
          httpGet:
            path: /
            port: 3000
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /
            port: 3000
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
      restartPolicy: Always
      volumes:
      - name: homepage-config
        hostPath:
          path: /mnt/k3s-storage/apps/homepage/config
          type: DirectoryOrCreate
---
# Service (enhanced from Kompose output, using LoadBalancer like BookStack)
apiVersion: v1
kind: Service
metadata:
  name: homepage
  namespace: homepage
  labels:
    app: homepage
    app.kubernetes.io/name: homepage
    app.kubernetes.io/component: dashboard
spec:
  type: LoadBalancer  # Use MetalLB LoadBalancer like BookStack
  ports:
  - name: http
    port: 3000
    targetPort: 3000
    protocol: TCP
  selector:
    app: homepage
---
# Simple HTTP-only Ingress for Homepage (TLS handled by Caddy)
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: homepage-ingress
  namespace: homepage
  labels:
    app: homepage
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web  # HTTP only, Caddy handles TLS
spec:
  ingressClassName: traefik
  rules:
  - host: {{ homepage_app_url | default('homepage.levangie.org') | regex_replace('^https?://') }}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: homepage
            port:
              number: 3000
