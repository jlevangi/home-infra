---
# BookStack Secrets - Generated by Ansible
apiVersion: v1
kind: Secret
metadata:
  name: bookstack-secrets
  namespace: bookstack
type: Opaque
data:
  # Base64 encoded database password
  DB_PASS: {{ applications.bookstack.secrets.db_password | b64encode }}
  
  # Base64 encoded MariaDB root password  
  MYSQL_ROOT_PASSWORD: {{ applications.bookstack.secrets.mysql_root_password | b64encode }}
  
  # Base64 encoded MariaDB user password (same as DB_PASS)
  MYSQL_PASSWORD: {{ applications.bookstack.secrets.db_password | b64encode }}
  
  # Base64 encoded Laravel application key
  APP_KEY: {{ applications.bookstack.secrets.app_key | b64encode }}
