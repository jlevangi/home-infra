---
# BookStack App Service
apiVersion: v1
kind: Service
metadata:
  name: bookstack
  namespace: bookstack
spec:
  selector:
    app: bookstack
  ports:
  - port: 8080
    targetPort: 80
  type: LoadBalancer
---
# BookStack MariaDB Service
apiVersion: v1
kind: Service
metadata:
  name: bookstack-mariadb
  namespace: bookstack
spec:
  selector:
    app: bookstack-mariadb
  ports:
  - port: 3306
    targetPort: 3306
  type: LoadBalancer
