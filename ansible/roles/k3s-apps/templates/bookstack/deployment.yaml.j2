---
# BookStack App Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bookstack
  namespace: bookstack
spec:
  replicas: 1
  selector:
    matchLabels:
      app: bookstack
  template:
    metadata:
      labels:
        app: bookstack
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      initContainers:
      - name: wait-for-db
        image: busybox:1.35
        command: ['sh', '-c']
        args:
        - |
          echo "Waiting for MariaDB to be ready..."
          until nc -z bookstack-mariadb 3306; do
            echo "MariaDB not ready, waiting..."
            sleep 10
          done
          echo "MariaDB is ready!"
          sleep 10
      containers:
      - name: bookstack
        image: linuxserver/bookstack:latest
        env:
        # - name: PUID  # NFS-related, commented out for Longhorn
        #   valueFrom:
        #     configMapKeyRef:
        #       name: bookstack-config
        #       key: PUID
        # - name: PGID  # NFS-related, commented out for Longhorn
        #   valueFrom:
        #     configMapKeyRef:
        #       name: bookstack-config
        #       key: PGID
        - name: DB_HOST
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_HOST
        - name: DB_PORT
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_PORT
        - name: DB_USERNAME
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_USER
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: DB_PASS
        - name: DB_DATABASE
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: DB_DATABASE
        - name: APP_URL
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: APP_URL
        - name: SESSION_LIFETIME
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: SESSION_LIFETIME
        - name: APP_KEY
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: APP_KEY
        - name: TZ
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: TZ
        ports:
        - containerPort: 80
        volumeMounts:
        - name: config-storage
          mountPath: /config
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 10
          failureThreshold: 5
        livenessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 90
          periodSeconds: 60
          timeoutSeconds: 10
          failureThreshold: 3
      volumes:
      - name: config-storage
        persistentVolumeClaim:
          claimName: bookstack-app-data-pvc
---
# BookStack MariaDB Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bookstack-mariadb
  namespace: bookstack
spec:
  replicas: 1
  selector:
    matchLabels:
      app: bookstack-mariadb
  template:
    metadata:
      labels:
        app: bookstack-mariadb
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      containers:
      - name: mariadb
        image: linuxserver/mariadb:latest
        env:
        # - name: PUID  # NFS-related, commented out for Longhorn
        #   valueFrom:
        #     configMapKeyRef:
        #       name: bookstack-config
        #       key: PUID
        # - name: PGID  # NFS-related, commented out for Longhorn
        #   valueFrom:
        #     configMapKeyRef:
        #       name: bookstack-config
        #       key: PGID
        - name: TZ
          valueFrom:
            configMapKeyRef:
              name: bookstack-config
              key: TZ
        - name: MYSQL_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: MYSQL_ROOT_PASSWORD
        - name: MYSQL_DATABASE
          value: "bookstack"
        - name: MYSQL_USER
          value: "bookstack"
        - name: MYSQL_PASSWORD
          valueFrom:
            secretKeyRef:
              name: bookstack-secrets
              key: MYSQL_PASSWORD
        ports:
        - containerPort: 3306
        volumeMounts:
        - name: db-storage
          mountPath: /config
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"
      volumes:
      - name: db-storage
        persistentVolumeClaim:
          claimName: bookstack-db-data-pvc
