---
# BookStack ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: bookstack-config
  namespace: bookstack
data:
  DB_HOST: "bookstack-mariadb"
  DB_PORT: "3306"
  DB_USER: "bookstack"
  DB_DATABASE: "bookstack"
  APP_URL: "{{ bookstack_app_url }}"
  SESSION_LIFETIME: "7200"
  # PUID: "{{ dynamic_nfs_uid | default('1024') }}"  # NFS-related, commented out for Longhorn
  # PGID: "{{ dynamic_nfs_gid | default('100') }}"   # NFS-related, commented out for Longhorn
  TZ: "{{ application_timezone | default('America/New_York') }}"
