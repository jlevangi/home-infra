# Homepage Dashboard Helm Values
# Generated by Ansible for {{ cluster_environment | default('unknown') }} environment

# Image configuration
image:
  repository: ghcr.io/gethomepage/homepage
  tag: "latest"
  pullPolicy: Always

# Service configuration
service:
  main:
    type: ClusterIP
    ports:
      http:
        port: {{ app_config.service_port | default(3000) }}

# Ingress configuration
ingress:
  main:
    enabled: false  # We handle ingress separately with Traefik

# Storage configuration
persistence:
  config:
    enabled: true
    size: {{ app_config.storage.config_initial_size | default('100Mi') }}
    accessMode: ReadWriteOnce

# Resource configuration
resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi

# Environment variables
env:
  TZ: America/New_York
  HOMEPAGE_ALLOWED_HOSTS: "{{ app_config.app_url | regex_replace('https?://','') }}"

# Security context
securityContext:
  runAsUser: 1000
  runAsGroup: 1000

# Replica count
replicaCount: 1