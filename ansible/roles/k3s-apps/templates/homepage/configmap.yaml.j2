---
# Homepage ConfigMap
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-config
  namespace: homepage
data:
  HOMEPAGE_ALLOWED_HOSTS: "{{ homepage_app_url | regex_replace('^https?://') }}"
  TZ: "{{ application_timezone | default('America/New_York') }}"
  PUID: "{{ dynamic_nfs_uid | default('1024') }}"
  PGID: "{{ dynamic_nfs_gid | default('100') }}"
