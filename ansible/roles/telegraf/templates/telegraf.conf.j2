# Telegraf Configuration for K3s Nodes
# Generated by Ansible

[global_tags]
  environment = "{{ telegraf_environment }}"
  cluster = "{{ telegraf_cluster_name }}"
  node_type = "{% if inventory_hostname in master_group %}master{% else %}worker{% endif %}"
  node_name = "{{ inventory_hostname }}"

[agent]
  interval = "{{ telegraf_interval }}"
  round_interval = true
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "10s"
  flush_jitter = "0s"
  precision = ""
  hostname = "{{ inventory_hostname }}"
  omit_hostname = false

# System Metrics
[[inputs.system]]

[[inputs.cpu]]
  percpu = true
  totalcpu = true
  collect_cpu_time = false
  report_active = false

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "overlay", "squashfs"]
  mount_points = ["/", "/mnt/k3s-storage"]

[[inputs.diskio]]

[[inputs.mem]]

[[inputs.swap]]

[[inputs.processes]]

[[inputs.nstat]]

[[inputs.net]]
  interfaces = ["eth*", "ens*", "flannel*", "cni*"]

# Kubernetes/K3s specific monitoring (disabled by default - requires kubelet auth setup)
# To enable: set telegraf_enable_kubernetes_input: true and configure kubelet authentication
{% if telegraf_enable_kubernetes_input | default(false) %}
[[inputs.kubernetes]]
  url = "https://127.0.0.1:10250"
  bearer_token = "/etc/telegraf/k8s_token"
  insecure_skip_verify = true
  response_timeout = "5s"
{% endif %}

# Container monitoring (only enabled when Docker is available, not K3s/containerd)
{% if telegraf_enable_docker_input | default(false) %}
[[inputs.docker]]
  endpoint = "unix:///var/run/docker.sock"
  timeout = "5s"
{% endif %}

# Monitor systemd services
[[inputs.systemd_units]]
  unittype = "service"
  pattern = "k3s*"

# Monitor kernel metrics
[[inputs.kernel]]

# Monitor temperature (if available)
[[inputs.temp]]

# InfluxDB Output
[[outputs.influxdb]]
  urls = ["{{ telegraf_influxdb_url }}"]
  database = "{{ telegraf_database }}"
  username = "{{ telegraf_username }}"
  password = "{{ telegraf_password }}"
  retention_policy = "{{ telegraf_retention_policy }}"
  write_consistency = "any"
  timeout = "5s"