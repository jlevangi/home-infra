global:
  tolerations: {{ longhorn_global_tolerations_json }}

defaultSettings:
  taintToleration: '{{ longhorn_taint_toleration_value }}'
  defaultReplicaCount: {{ longhorn_replica_count | default(calculated_replica_count | default(3)) }}
  storageReservedPercentageForDefaultDisk: {{ longhorn_storage_reserved_percentage_for_default_disk | default(5) }}
  storageOverProvisioningPercentage: {{ longhorn_storage_over_provisioning_percentage | default(200) }}
  defaultDataPath: "{{ longhorn_default_data_path | regex_replace('/$','') }}/"
  # Engine/rebuild tuning — see k3s_cluster.yml for rationale.
  autoSalvage: {{ longhorn_auto_salvage | default(true) | bool | string | lower }}
  engineReplicaTimeout: {{ longhorn_engine_replica_timeout | default(30) }}
  replicaReplenishmentWaitInterval: {{ longhorn_replica_replenishment_wait_interval | default(600) }}
  concurrentReplicaRebuildPerNodeLimit: {{ longhorn_concurrent_replica_rebuild_per_node_limit | default(2) }}
{% if enable_longhorn_backup | default(true) and nfs_server_ip is defined %}
  backupTarget: "nfs://{{ nfs_server_ip }}:{{ nfs_share_backup }}{% if longhorn_backup_shared_across_clusters | default(false) %}/shared{% else %}/{{ cluster_environment | default('prod') }}{% endif %}"
{% endif %}

# StorageClass ownership: the chart's longhorn-storageclass ConfigMap (and the
# default `longhorn` SC it generates) is disabled here so ArgoCD can own the
# manifest under argocd/manifests/longhorn-storage-classes/ without fighting
# longhorn-manager's configmap-driven reconcile. See home-infra-btv.
persistence:
  defaultClass: false