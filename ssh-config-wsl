# K3s cluster nodes SSH configuration for WSL
# This file should be placed at: ~/.ssh/config in WSL

# Global settings for K3s nodes
Host k3s-node-*
    User pierce
    IdentityFile ~/.ssh/pierce
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3

Host k3s-test-node-*
    User pierce
    IdentityFile ~/.ssh/pierce
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ConnectTimeout 10
    ServerAliveInterval 60
    ServerAliveCountMax 3


# Individual K3s node configurations
Host k3s-node-1
    HostName 172.20.20.101
    # Master node

Host k3s-node-2
    HostName 172.20.20.102
    # Worker node

Host k3s-node-3
    HostName 172.20.20.103
    # Worker node

Host k3s-test-node-1
    HostName 172.20.20.111
    # Master node

Host k3s-test-node-2
    HostName 172.20.20.112
    # Worker node

Host k3s-test-node-3
    HostName 172.20.20.113
    # Worker node

# Short aliases for convenience
Host k3s-master
    HostName 172.20.20.101
    User pierce
    IdentityFile ~/.ssh/pierce
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host k3s-worker-1
    HostName 172.20.20.102
    User pierce
    IdentityFile ~/.ssh/pierce
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host k3s-worker-2
    HostName 172.20.20.103
    User pierce
    IdentityFile ~/.ssh/pierce
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null



# Generic wildcard for any IP in the 172.20.20.x range
Host 172.20.20.*
    User pierce
    IdentityFile ~/.ssh/pierce
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ConnectTimeout 10
