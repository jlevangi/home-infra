{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [
    "ansible/**",
    "scripts/**",
    "terraform/archive/**"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/argocd/manifests/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/argocd/apps/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Application container image non-major updates - weekly individual PRs",
      "matchFileNames": ["argocd/manifests/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "schedule": ["after 6am on Monday"],
      "automerge": false
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/immich/**"],
      "addLabels": ["app:immich"]
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/affine/**"],
      "addLabels": ["app:affine"]
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/hoarder/**"],
      "addLabels": ["app:hoarder"]
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/paperless/**"],
      "addLabels": ["app:paperless"]
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/n8n/**"],
      "addLabels": ["app:n8n"]
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/plausible/**"],
      "addLabels": ["app:plausible"]
    },
    {
      "description": "Application ownership labels for lifecycle-coupled manifests",
      "matchFileNames": ["argocd/manifests/open-notebook/**"],
      "addLabels": ["app:open-notebook"]
    },
    {
      "description": "Stateful engines require application compatibility review",
      "matchFileNames": ["argocd/manifests/**"],
      "matchPackageNames": [
        "postgres",
        "postgis/postgis",
        "mysql",
        "mariadb",
        "redis",
        "docker.io/valkey/valkey",
        "clickhouse/clickhouse-server",
        "getmeili/meilisearch",
        "surrealdb/surrealdb",
        "ghcr.io/immich-app/postgres"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": ["component:stateful", "compatibility-review"]
    },
    {
      "description": "Authentication proxies require application login verification",
      "matchPackageNames": ["quay.io/oauth2-proxy/oauth2-proxy"],
      "dependencyDashboardApproval": true,
      "addLabels": ["component:auth"]
    },
    {
      "description": "Shared helper images need affected-application review",
      "matchPackageNames": ["busybox", "curlimages/curl", "python"],
      "addLabels": ["component:helper"]
    },
    {
      "description": "Split BusyBox and Python updates by owning manifest directory",
      "matchPackageNames": ["busybox", "python"],
      "additionalBranchPrefix": "{{packageFileDir}}-"
    },
    {
      "description": "Ignore LinuxServer qBittorrent legacy date-based build tags",
      "matchPackageNames": ["ghcr.io/linuxserver/qbittorrent"],
      "allowedVersions": "/^[0-9]\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "description": "Postgres major upgrades need manual data migration planning",
      "matchFileNames": ["argocd/manifests/**"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Immich PostgreSQL major upgrades require a planned data migration",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "allowedVersions": "/^14-/"
    },
    {
      "description": "ClickHouse major upgrades need Plausible-specific validation and rollback planning",
      "matchFileNames": ["argocd/manifests/**"],
      "matchPackageNames": ["clickhouse/clickhouse-server"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Stateful database majors require an explicit migration plan",
      "matchFileNames": ["argocd/manifests/**"],
      "matchPackageNames": [
        "postgres",
        "postgis/postgis",
        "mariadb",
        "mysql",
        "redis",
        "docker.io/valkey/valkey",
        "clickhouse/clickhouse-server",
        "getmeili/meilisearch",
        "surrealdb/surrealdb"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Hoarder Meilisearch data requires dump/import or upgrade-db migration",
      "matchFileNames": ["argocd/manifests/hoarder/**"],
      "matchPackageNames": ["getmeili/meilisearch"],
      "allowedVersions": "/^v1\\.6(?:\\.|$)/"
    },
    {
      "description": "netbootxyz major updates - isolate from database image upgrades",
      "matchFileNames": ["argocd/manifests/netbootxyz/overlays/prod/**"],
      "matchPackageNames": ["lscr.io/linuxserver/netbootxyz"],
      "matchUpdateTypes": ["major"],
      "schedule": ["after 6am on Monday"],
      "automerge": false,
      "groupName": "prod-netbootxyz-major"
    },
    {
      "description": "Vault chart - manual only due OnDelete StatefulSet rollout",
      "matchFileNames": ["argocd/apps/prod/vault.yaml"],
      "matchManagers": ["argocd"],
      "enabled": false
    },
    {
      "description": "Prod Helm chart non-major updates - weekly individual PRs",
      "matchFileNames": ["argocd/apps/prod/**"],
      "matchManagers": ["argocd"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "schedule": ["after 6am on Monday"],
      "automerge": false
    },
    {
      "description": "kube-prometheus-stack major updates - isolate CRD/operator changes",
      "matchFileNames": ["argocd/apps/prod/kube-prometheus-stack.yaml"],
      "matchManagers": ["argocd"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "matchUpdateTypes": ["major"],
      "schedule": ["after 6am on Monday"],
      "automerge": false,
      "groupName": "prod-kube-prometheus-stack-major"
    },
    {
      "description": "Loki major updates - isolate chart schema and StatefulSet changes",
      "matchFileNames": ["argocd/apps/prod/loki.yaml"],
      "matchManagers": ["argocd"],
      "matchPackageNames": ["loki"],
      "matchUpdateTypes": ["major"],
      "schedule": ["after 6am on Monday"],
      "automerge": false,
      "groupName": "prod-loki-major"
    },
    {
      "description": "Inactive non-prod K3s environments - disabled",
      "matchFileNames": [
        "argocd/apps/stage/**",
        "argocd/apps/test/**",
        "argocd/apps/talos-test/**",
        "argocd/manifests/*/overlays/stage/**",
        "argocd/manifests/*/overlays/test/**"
      ],
      "enabled": false
    },
    {
      "description": "Terraform - monthly",
      "matchManagers": ["terraform"],
      "schedule": ["before 6am on the first day of the month"],
      "automerge": false,
      "groupName": "terraform-providers"
    },
    {
      "description": "Major updates need review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    },
    {
      "description": "Plex - patch only (complex versioning)",
      "matchPackageNames": ["plexinc/pms-docker"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "PocketID - stay on v1.x",
      "matchPackageNames": ["ghcr.io/pocket-id/pocket-id"],
      "allowedVersions": "/^v1\\./"
    }
  ],
  "labels": ["renovate"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "timezone": "America/New_York"
}
