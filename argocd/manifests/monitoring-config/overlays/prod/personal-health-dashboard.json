          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  start_time::date AS \"time\",\n  metric_type,\n  COUNT(*)::int AS \"count\"\nFROM health_observations_raw\nWHERE metric_type IN ('steps','heart_rate','active_energy','distance','weight','resting_heart_rate','oxygen_saturation','sleep_segment','calories')\n  AND start_time::timestamptz >= now() - interval '30 days'\nGROUP BY 1, 2\nORDER BY 1 DESC, 2",
