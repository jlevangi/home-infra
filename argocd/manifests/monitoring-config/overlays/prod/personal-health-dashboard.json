          "rawSql": "SELECT\n  r.value_text AS \"metric\",\n  SUM(EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz))) / 3600.0 AS \"hours\"\nFROM health_observations_raw r\nJOIN health_sources s ON s.id = r.source_id\nWHERE r.metric_type = 'sleep_segment'\n  AND s.source_system = 'health_sync'\n  AND r.value_text IN ('light', 'deep', 'rem', 'awake')\n  AND $__timeFilter(r.start_time::timestamptz)\nGROUP BY 1\nORDER BY 2 DESC",
