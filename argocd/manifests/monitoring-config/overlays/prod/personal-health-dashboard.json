        {
          "datasource": {
            "type": "postgres",
            "uid": "health-archive"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH nights AS (\n  SELECT\n    date_trunc('day', r.start_time::timestamptz - interval '12 hours') + interval '12 hours' AS night,\n    EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz)) / 3600.0 AS hrs\n  FROM health_observations_raw r\n  JOIN health_sources s ON s.id = r.source_id\n  WHERE r.metric_type = 'sleep_segment'\n    AND s.source_system = 'health_sync'\n    AND COALESCE(r.value_text, '') <> 'awake'\n)\nSELECT SUM(hrs) AS \"Last Night's Sleep (h)\"\nFROM nights\nWHERE night = (SELECT MAX(night) FROM nights)",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "title": "Last Night's Sleep",
      "type": "stat"
    },
