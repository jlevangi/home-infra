      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "health-archive"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', r.start_time::timestamptz - interval '12 hours') + interval '12 hours' AS \"time\",\n  SUM(EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz))) / 3600.0 AS \"sleep_hours\"\nFROM health_observations_raw r\nJOIN health_sources s ON s.id = r.source_id\nWHERE r.metric_type = 'sleep_segment'\n  AND s.source_system = 'health_sync'\n  AND COALESCE(r.value_text, '') <> 'awake'\n  AND $__timeFilter(r.start_time::timestamptz)\nGROUP BY 1\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "title": "Sleep Duration (hours)",
      "type": "timeseries"
