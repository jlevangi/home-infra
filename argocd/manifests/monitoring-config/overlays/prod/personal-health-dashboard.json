        {
          "datasource": {
            "type": "postgres",
            "uid": "health-archive"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', r.start_time::timestamptz - interval '12 hours') + interval '12 hours' AS \"time\",\n  SUM(CASE WHEN r.value_text = 'light' THEN EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz)) / 3600.0 ELSE 0 END) AS \"Light\",\n  SUM(CASE WHEN r.value_text = 'deep' THEN EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz)) / 3600.0 ELSE 0 END) AS \"Deep\",\n  SUM(CASE WHEN r.value_text = 'rem' THEN EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz)) / 3600.0 ELSE 0 END) AS \"REM\",\n  SUM(CASE WHEN r.value_text = 'awake' THEN EXTRACT(EPOCH FROM (r.end_time::timestamptz - r.start_time::timestamptz)) / 3600.0 ELSE 0 END) AS \"Awake\"\nFROM health_observations_raw r\nJOIN health_sources s ON s.id = r.source_id\nWHERE r.metric_type = 'sleep_segment'\n  AND s.source_system = 'health_sync'\n  AND $__timeFilter(r.start_time::timestamptz)\nGROUP BY 1\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "title": "Sleep by Night (stage breakdown)",
