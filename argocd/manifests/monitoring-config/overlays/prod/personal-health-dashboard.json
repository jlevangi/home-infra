          "rawSql": "SELECT\n  time,\n  steps AS \"Steps\",\n  AVG(steps) OVER (ORDER BY time ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS \"7d Avg\"\nFROM (\n  SELECT\n    date_trunc('day', start_time::timestamptz) AS \"time\",\n    SUM(value_numeric) AS steps\n  FROM health_observations_raw\n  WHERE metric_type = 'steps'\n    AND $__timeFilter(start_time::timestamptz)\n  GROUP BY 1\n) daily\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "title": "Steps (daily + 7-day average)",
      "type": "timeseries"
